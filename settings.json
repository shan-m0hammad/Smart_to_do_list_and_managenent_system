
{
  // Uses GCC as the C compiler.
  "C_Cpp_Runner.cCompilerPath": "gcc",

  // Uses G++ as the C++ compiler.
  "C_Cpp_Runner.cppCompilerPath": "g++",

  // Uses GDB as the debugger.
  "C_Cpp_Runner.debuggerPath": "gdb",

  // C language standard is not specified.
  "C_Cpp_Runner.cStandard": "",

  // C++ language standard is not specified.
  "C_Cpp_Runner.cppStandard": "",

  // Path to Visual Studio compiler environment setup file.
  "C_Cpp_Runner.msvcBatchPath": "C:/Program Files/Microsoft Visual Studio/VR_NR/Community/VC/Auxiliary/Build/vcvarsall.bat",

  // Uses GCC/G++ instead of Microsoft Visual C++ compiler.
  "C_Cpp_Runner.useMsvc": false,

  // Warning flags used by GCC and G++.
  "C_Cpp_Runner.warnings": [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wshadow",
    "-Wformat=2",
    "-Wcast-align",
    "-Wconversion",
    "-Wsign-conversion",
    "-Wnull-dereference"
  ],

  // Warning flags used by Microsoft Visual C++ compiler.
  "C_Cpp_Runner.msvcWarnings": [
    "/W4",
    "/permissive-",
    "/w14242",
    "/w14287",
    "/w14296",
    "/w14311",
    "/w14826",
    "/w44062",
    "/w44242",
    "/w14905",
    "/w14906",
    "/w14263",
    "/w44265",
    "/w14928"
  ],

  // Enables compiler warnings.
  "C_Cpp_Runner.enableWarnings": true,

  // Warnings are not treated as errors.
  "C_Cpp_Runner.warningsAsError": false,

  // Additional compiler arguments.
  "C_Cpp_Runner.compilerArgs": [],

  // Additional linker arguments.
  "C_Cpp_Runner.linkerArgs": [],

  // Additional header file search directories.
  "C_Cpp_Runner.includePaths": [],

  // Files and folders included in source file searching.
  "C_Cpp_Runner.includeSearch": [
    "*",
    "**/*"
  ],

  // Files and folders excluded from source file searching.
  "C_Cpp_Runner.excludeSearch": [
    "**/build",
    "**/build/**",
    "**/.*",
    "**/.*/**",
    "**/.vscode",
    "**/.vscode/**"
  ],

  // Disables AddressSanitizer.
  "C_Cpp_Runner.useAddressSanitizer": false,

  // Disables UndefinedBehaviorSanitizer.
  "C_Cpp_Runner.useUndefinedSanitizer": false,

  // Disables LeakSanitizer.
  "C_Cpp_Runner.useLeakSanitizer": false,

  // Hides compilation time.
  "C_Cpp_Runner.showCompilationTime": false,

  // Disables Link-Time Optimization.
  "C_Cpp_Runner.useLinkTimeOptimization": false,

  // Does not suppress MSVC secure-function warnings.
  "C_Cpp_Runner.msvcSecureNoWarnings": false
}
